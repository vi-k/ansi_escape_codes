{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "main",
            "request": "launch",
            "type": "dart",
            "program": "example/ansi_escape_codes_example.dart",
        },
        {
            "name": "styles",
            "request": "launch",
            "type": "dart",
            "program": "example/styles.dart",
        },
        {
            "name": "check compatibility",
            "request": "launch",
            "type": "dart",
            "program": "example/check_compatibility.dart",
        },
        {
            "name": "colors256",
            "request": "launch",
            "type": "dart",
            "program": "example/colors256.dart",
        },
        {
            "name": "rgb",
            "request": "launch",
            "type": "dart",
            "program": "example/rgb.dart",
        },
        {
            "name": "control",
            "request": "launch",
            "type": "dart",
            "program": "example/control.dart",
        },
        {
            "name": "links",
            "request": "launch",
            "type": "dart",
            "program": "example/links.dart",
        },
        {
            "name": "progress_indicator",
            "request": "launch",
            "type": "dart",
            "program": "example/progress_indicator.dart",
        },
        {
            // noDebug: the debugger slows the VM down unevenly, and a
            // benchmark run under it measures the debugger.
            //
            // --color: this terminal answers "no" to being asked whether it
            // can do escape codes, and then shows them perfectly well.
            "name": "benchmark",
            "request": "launch",
            "type": "dart",
            "program": "benchmark/parser_benchmark.dart",
            "args": ["--color"],
            "noDebug": true,
        },
        {
            // noDebug and --color for the same reasons as the benchmark:
            // both sides run the benchmark, and this terminal shows the
            // colours it denies having. The base ref is asked for on
            // launch; the head side is the working tree as it stands.
            "name": "benchmark compare",
            "request": "launch",
            "type": "dart",
            "program": "benchmark/compare.dart",
            "args": ["${input:compareBaseRef}", "--color"],
            "noDebug": true,
        },
    ],
    "inputs": [
        {
            "id": "compareBaseRef",
            "type": "promptString",
            "description": "Base ref: main, a release tag, or perf-baseline-4.0.0 (the state before the 4.0.0 performance work)",
            "default": "main",
        },
    ]
}
